# ============================================
# .env.example — Hednai Backend
# Copier ce fichier en .env et remplir les valeurs.
# Le schema de validation complet est dans src/config/env.ts :
# le serveur refuse de demarrer si une variable requise manque.
# ============================================

# === REQUIS : base de donnees PostgreSQL ===
# En local :
DATABASE_URL=postgresql://user:password@localhost:5432/hednai_db
# En production sur Neon, remplacer par :
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === REQUIS : token des routes admin, 32 caracteres minimum ===
# Generer avec : openssl rand -hex 32
ADMIN_TOKEN=

# === OPTIONNEL : environnement d'execution ===
# development | test | production (defaut : development)
NODE_ENV=development

# === OPTIONNEL : origines autorisees par CORS, separees par une virgule ===
FRONTEND_URL=http://localhost:5173

# === OPTIONNEL : port du serveur (defaut : 3000) ===
PORT=3000

# === ENVOI D'EMAILS : Resend (API HTTP, prioritaire sur le SMTP) ===
# Laisser vide en local : sans cle, l'envoi bascule sur le SMTP ci-dessous
RESEND_API_KEY=
MAIL_FROM=Hednai <contact@send.hednai.com>

# === OPTIONNEL : destinataire des messages du formulaire de contact ===
CONTACT_EMAIL=contact@hednai.com

# === OPTIONNEL : repli SMTP, utilise si RESEND_API_KEY est absente ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=motdepasse

# === OPTIONNEL : cache Redis ===
# REDIS_URL=redis://default:motdepasse@hote.upstash.io:6379

# === OPTIONNEL : webhook Discord, notification a chaque message recu ===
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy