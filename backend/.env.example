# ============================================
# .env.example — Hednai Backend
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# === REQUIS : base de donnees PostgreSQL ===
DATABASE_URL=postgresql://user:password@localhost:5432/hednai_db

# === OPTIONNEL : URL du frontend autorise par CORS ===
FRONTEND_URL=http://localhost:5173

# === OPTIONNEL : port du serveur (defaut: 3000) ===
PORT=3000

# === OPTIONNEL : Redis pour le cache ===
# REDIS_URL=redis://localhost:6379

# === OPTIONNEL : SMTP pour l'envoi d'emails ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=motdepasse

# === OPTIONNEL : email de destination des messages contact ===
CONTACT_EMAIL=contact@hednai.com

# === REQUIS : token d'authentification pour les routes admin (min 32 caracteres) ===
# Generer avec : openssl rand -hex 32
ADMIN_TOKEN=