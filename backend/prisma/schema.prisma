// ============================================
// Prisma Schema — Hednai v6
// Base de donnees PostgreSQL
// Modeles : Message (contact) + AuditLog (journalisation)
// ============================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Message de contact ────────────────────────
// email et phone sont optionnels car un visiteur peut choisir
// de contacter par Email OU par WhatsApp (pas les deux)
// contactMethod indique quel canal a ete utilise
model Message {
  id            Int      @id @default(autoincrement())
  name          String
  email         String?
  phone         String?
  contactMethod String   @default("email")
  subject       String
  message       String
  createdAt     DateTime @default(now())
}

// ── Types d'actions pour l'audit ──────────────
enum ActionType {
  CONTACT_SUBMIT
  CONTACT_EMAIL_SENT
  CONTACT_EMAIL_FAILED
}

// ── Journal d'audit ───────────────────────────
// Les logs restent en base, pas de route API exposee (securite)
model AuditLog {
  id         String     @id @default(uuid())
  action     ActionType
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  payload    Json?
  createdAt  DateTime   @default(now())

  @@index([action, createdAt])
}