# ============================================
# .gitignore
# ============================================

# Dependances
node_modules/

# Build
dist/
build/

# Variables d'environnement (ne JAMAIS committer)
# Le motif ".env*" attrape aussi .env.dev, .env.render, .env.backup, etc.
# L'exception "!*.env.example" garde le modèle versionné.
.env
.env.*
!.env.example
!*.env.example

# Prisma
backend/prisma/migrations/

# Client Prisma genere automatiquement
# (se regenere avec "npx prisma generate", pas besoin de le committer)
backend/src/generated/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Coverage tests
coverage/

# Cypress
cypress/videos
cypress/screenshots
cypress/downloads